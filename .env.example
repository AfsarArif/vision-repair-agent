DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_LLM_MODEL=deepseek-chat
DATABASE_URL=postgresql+asyncpg://repair_agent:repair_agent@localhost:5432/repair_agent_db
SYNC_DATABASE_URL=postgresql+psycopg://repair_agent:repair_agent@localhost:5432/repair_agent_db
PERSISTENCE_BACKEND=memory
CORPUS_DIR=./docs/corpus
DATA_DIR=./data
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_RERANKER=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_FETCH_K=20
CV_BACKEND=yolo
YOLO_WEIGHTS=data/processed/deeppcb/weights/best.pt
YOLO_CONF=0.55
YOLO_CANDIDATE_CONF=0.4
CONFIDENCE_THRESHOLD=0.8
TEMPLATE_MIN_COVERAGE=0.05
MAX_CORRECTION_RETRIES=3
TESSERACT_CMD=/usr/bin/tesseract
LOG_LEVEL=INFO
